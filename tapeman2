def _show_slot_map(changer_dev):
    header("Library Slot Map")
    try:
        status = core.library_status_with_db(changer_dev, DB)
    except Exception as e:
        error("Failed to read library: {}".format(e))
        pause()
        return

    def slot_line(s):
        occupied_str = s.barcode or s.label or "(empty)"
        type_str = {"drive": "DRIVE", "storage": "SLOT ", "ie": "I/E  "}.get(
            s.slot_type, "?    ")
        if RICH:
            color = "green" if s.occupied else "dim"
            loaded = " [cyan]*LOADED*[/cyan]" if s.slot_type == "drive" and s.occupied else ""
            console.print("  [{}]{} {:3d}[/{}]  {}{}".format(
                color, type_str, s.slot_num, color, occupied_str, loaded))
        else:
            loaded = " *LOADED*" if s.slot_type == "drive" and s.occupied else ""
            print("  {} {:3d}  {}{}".format(type_str, s.slot_num, occupied_str, loaded))

    if status.drives:
        if RICH:
            console.print("  [bold cyan]── Drives ──[/bold cyan]")
        else:
            print("  ── Drives ──")
        for d in status.drives:
            slot_line(d)

    if status.ie_slots:
        if RICH:
            console.print("\n  [bold cyan]── Import/Export ──[/bold cyan]")
        else:
            print("\n  ── Import/Export ──")
        for s in status.ie_slots:
            slot_line(s)

    if RICH:
        console.print("\n  [bold cyan]── Storage Slots ──[/bold cyan]")
    else:
        print("\n  ── Storage Slots ──")
    for s in status.slots:
        slot_line(s)

    pause()

