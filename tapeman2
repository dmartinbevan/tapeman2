# ── Tape Management ───────────────────────────────────────────────────────────

def do_tape_management():
    while True:
        header("Tape Management")
        status_line()
        choice = show_menu("Tape Operations", [
            ("1", "Mount tape"),
            ("2", "Unmount & eject tape"),
            ("3", "Format a NEW tape (destructive)"),
            ("4", "Show drive status"),
            ("5", "Register tape in database"),
            ("b", "Back"),
        ])

        if choice == "1":
            _mount_tape()
        elif choice == "2":
            _unmount_tape()
        elif choice == "3":
            _format_tape()
        elif choice == "4":
            _drive_status()
        elif choice == "5":
            _register_tape()
        elif choice == "b":
            break

def _mount_tape():
    header("Mount Tape")
    if core.is_mounted(MOUNT):
        warn("A tape is already mounted.")
        pause()
        return
    info("Make sure the tape is loaded in the drive.")
    if not confirm("Proceed with mount?"):
        return
    try:
        core.mount_tape(SG, MOUNT, progress_cb=progress_msg, st_device=ST)
        info(f"Tape mounted at {MOUNT}")
    except core.TapeError as e:
        error(str(e))
    pause()

def _unmount_tape():
    header("Unmount & Eject Tape")
    if not core.is_mounted(MOUNT):
        warn("No tape is currently mounted.")
        if confirm("Eject tape anyway?", default=False):
            core.eject_tape(ST)
            info("Tape ejected.")
        pause()
        return

    # Check cleaning while tape is still accessible
    info("Checking drive status...")
    needs_clean, clean_msg = core.cleaning_status_str(SG, ST)

    # Offer verify before unmount
    try:
        tapes = core.list_tapes(DB)
        if tapes:
            if confirm("Verify datasets on this tape before ejecting?", default=False):
                tape_label = prompt("Enter tape label to verify")
                if tape_label:
                    results = core.verify_tape_datasets(
                        tape_label, DB, MOUNT, ALGO, progress_cb=progress_msg
                    )
                    for aid, ok in results.items():
                        if ok:
                            info("{}: verified".format(aid))
                        else:
                            error("{}: FAILED".format(aid))
    except Exception:
        pass

    try:
        core.unmount_tape(MOUNT, progress_cb=progress_msg)
        info("Tape unmounted.")
        if confirm("Eject the tape?", default=True):
            core.eject_tape(ST)
            info("Tape ejected. Safe to remove.")
    except core.TapeError as e:
        error(str(e))
        pause()
        return

    # Show cleaning warning after eject
    if needs_clean:
        print()
        if RICH:
            console.print("  [bold red]⚠  DRIVE NEEDS CLEANING[/bold red]")
            console.print("  [yellow]  Reason: {}[/yellow]".format(clean_msg))
            console.print("  [dim]  Load a cleaning cartridge before the next archive job.[/dim]")
        else:
            print("  *** DRIVE NEEDS CLEANING ***")
            print("  Reason: {}".format(clean_msg))
            print("  Load a cleaning cartridge before next use.")
        if confirm("Log this cleaning reminder?", default=True):
            core.log_cleaning_event(DB, SG, action="cleaning_needed", notes=clean_msg)
            info("Logged to maintenance log.")

    pause()

def _format_tape():
    header("Format New Tape")
    if core.is_mounted(MOUNT):
        error("A tape is currently mounted. Unmount it first.")
        pause()
        return

    if RICH:
        console.print("  [bold red]WARNING: This will ERASE ALL DATA on the tape.[/bold red]\n")
        console.print(
            "  LTFS requires a [bold]6-character alphanumeric serial[/bold] (e.g. [cyan]LAB001[/cyan]).\n"
            "  You can also give the tape a longer descriptive volume name.\n")
    else:
        print("  WARNING: This will ERASE ALL DATA on the tape.\n")
        print("  LTFS tape serial must be exactly 6 alphanumeric characters (e.g. LAB001).\n")

    serial = prompt("Tape serial (6 chars, letters/numbers only, e.g. LAB001)").upper().strip()
    serial = "".join(c for c in serial if c.isalnum())[:6]
    if len(serial) != 6:
        error("Serial must be exactly 6 alphanumeric characters. Got: '{}'".format(serial))
        pause()
        return

    volume_name = prompt(
        "Volume name (optional longer description, e.g. Calero-Lab-Tape-1)",
        default=serial
    ).strip()

    confirm_str = input("\n  Type YES to confirm formatting tape '{}' ({}): ".format(
        serial, volume_name)).strip()
    if confirm_str != "YES":
        warn("Format cancelled.")
        pause()
        return

    info("Waiting for tape to be ready...")
    info("NOTE: New tapes may take 15-30 minutes to initialize before formatting.")
    print()

    try:
        core.format_tape(SG, serial, volume_name=volume_name, progress_cb=progress_msg)
        info("Tape '{}' ({}) formatted successfully.".format(serial, volume_name))
        core.add_tape(DB, serial)
        info("Tape '{}' registered in database.".format(serial))
        if confirm("Mount the tape now?"):
            core.mount_tape(SG, MOUNT, progress_cb=progress_msg, st_device=ST)
            info("Tape mounted at {}".format(MOUNT))
    except core.TapeError as e:
        error(str(e))
    pause()

def _drive_status():
    header("Drive Status")
    status = core.tape_status(ST)
    if RICH:
        console.print(Panel(status, title="mt status", border_style="dim"))
    else:
        print(status)

    if core.is_mounted(MOUNT):
        total = core.tape_total_bytes(MOUNT)
        free = core.tape_free_bytes(MOUNT)
        used = total - free
        info(f"Mounted: {MOUNT}")
        info(f"Total:   {core.human_size(total)}")
        info(f"Used:    {core.human_size(used)}")
        info(f"Free:    {core.human_size(free)}")
    pause()

def _register_tape():
    header("Register Tape")
    label = prompt("Tape label").upper().replace(" ", "")
    if not label:
        return
    notes = prompt("Notes (optional)", default="")
    core.add_tape(DB, label, notes)
    info(f"Tape '{label}' registered.")
    pause()

# ── Archive ───────────────────────────────────────────────────────────────────

def do_archive():
    header("Archive Dataset")

    if not core.is_mounted(MOUNT):
        error("No tape mounted. Mount a tape first (Tape Management → Mount).")
        pause()
        return

    print()
    info("Tape mounted. Free space: {}".format(core.human_size(core.tape_free_bytes(MOUNT))))
    print()

    source_path = prompt("Source path to archive (full path)").strip()
    if not source_path or not os.path.exists(source_path):
        error("Path does not exist: {}".format(source_path))
        pause()
        return

    src_size, src_count = core.dir_size_and_count(source_path)
    info("Source: {} in {} files".format(core.human_size(src_size), src_count))
    print()

    name       = prompt("Dataset name (human readable)")
    lab        = prompt("Lab name (optional)", default="")
    pi         = prompt("PI name (optional)", default="")
    notes      = prompt("Notes (optional)", default="")
    tape_label = prompt("Which tape is loaded? (label)")
    if not tape_label:
        error("Tape label required.")
        pause()
        return
    tape_label = tape_label.upper().replace(" ", "")
    use_tar    = confirm(
        "Bundle as tar archive? (recommended for many small files)", default=TAR_DEF
    )
    direct     = confirm(
        "Direct write to tape? (skip staging — use if source is on fast local disk)",
        default=False
    )

    print()

    # Preflight
    errors = core.preflight_check(source_path, STAGING, MOUNT, MIN_STG,
                                  direct_write=direct)
    if errors:
        if RICH:
            console.print("  [red bold]Preflight checks failed:[/red bold]")
        else:
            print("  Preflight checks failed:")
        for e in errors:
            error(e)
        if not confirm("Proceed anyway?", default=False):
            pause()
            return

    # Optional dry run
    if confirm("Run a dry run first (no data written)?", default=False):
        rec = core.archive_dataset(
            source_path=source_path, name=name, tape_label=tape_label,
            db_path=DB, staging_dir=STAGING, mount_point=MOUNT,
            checksum_algo=ALGO, use_tar=use_tar,
            lab=lab, pi=pi, notes=notes,
            progress_cb=progress_msg, dry_run=True
        )
        info("Dry run complete — would create {}".format(rec.archive_id))
        if not confirm("Proceed with actual archive?", default=True):
            pause()
            return

    # Submit background job
    print()
    job = core.submit_archive_job(
        state_dir=STATE_DIR, db_path=DB,
        source_path=source_path, name=name, tape_label=tape_label,
        staging_dir=STAGING, mount_point=MOUNT,
        checksum_algo=ALGO, use_tar=use_tar,
        lab=lab, pi=pi, notes=notes,
        cfg=cfg, sg_device=SG, st_device=ST,
        direct_write=direct,
    )
    print()
    if RICH:
        from rich.panel import Panel
        console.print(Panel(
            "[green bold]Archive job submitted![/green bold]\n\n"
            "  Job ID:   [cyan]{}[/cyan]\n"
            "  Dataset:  {}\n"
            "  Tape:     {}\n"
            "  Source:   {}\n\n"
            "[dim]Running in background — safe to close tapeman2.\n"
            "Check progress in the Jobs menu (option 6).[/dim]".format(
                job["job_id"], name, tape_label, source_path),
            title="Job Submitted", border_style="green"
        ))
    else:
        print("  Archive job submitted: {}".format(job["job_id"]))
        print("  Running in background — check Jobs menu (option 6) for status.")
    pause()

# ── Restore ───────────────────────────────────────────────────────────────────

def do_restore():
    header("Restore Dataset")

    archives = core.list_archives(DB)
    if not archives:
        warn("No archives in database.")
        pause()
        return

    show_archives_table(archives, "Available Archives")
    print()

    archive_id = prompt("Enter Archive ID to restore (e.g. ARCH-0001)").upper().strip()
    if not archive_id:
        return

    rec = core.get_archive(DB, archive_id)
    if not rec:
        error("Archive ID '{}' not found.".format(archive_id))
        pause()
        return

    if RICH:
        from rich.panel import Panel
        console.print(Panel(
            "  Name:    {}\n  Tape:    [yellow]{}[/yellow]\n"
            "  Size:    {}\n  Date:    {}\n  Source:  {}".format(
                rec.name, rec.tape_label, core.human_size(rec.size_bytes),
                rec.date_archived, rec.source_path),
            title="Archive {}".format(archive_id), border_style="cyan"
        ))
    else:
        print("\n  Archive: {}  Name: {}  Tape: {}".format(
            archive_id, rec.name, rec.tape_label))

    print()
    if RICH:
        console.print("  [yellow]Please load tape: [bold]{}[/bold][/yellow]".format(
            rec.tape_label))
    else:
        print("  Please load tape: {}".format(rec.tape_label))
    print()

    if not core.is_mounted(MOUNT):
        if confirm("Tape not mounted. Mount it now?"):
            try:
                core.mount_tape(SG, MOUNT, progress_cb=progress_msg, st_device=ST)
            except core.TapeError as e:
                error(str(e))
                pause()
                return
        else:
            pause()
            return

    dest = prompt("Restore destination path", default=RESTORE).strip()
    if not dest:
        error("Destination required.")
        pause()
        return

    print()
    job = core.submit_restore_job(
        state_dir=STATE_DIR, db_path=DB,
        archive_id=archive_id, dest_path=dest,
        mount_point=MOUNT, checksum_algo=ALGO,
        cfg=cfg, sg_device=SG, st_device=ST,
    )
    if RICH:
        from rich.panel import Panel
        console.print(Panel(
            "[green bold]Restore job submitted![/green bold]\n\n"
            "  Job ID:      [cyan]{}[/cyan]\n"
            "  Archive:     {}\n"
            "  Destination: {}\n\n"
            "[dim]Running in background — check Jobs menu (option 6).[/dim]".format(
                job["job_id"], archive_id, dest),
            title="Job Submitted", border_style="green"
        ))
    else:
        print("  Restore job submitted: {}".format(job["job_id"]))
    pause()

# ── Verify ────────────────────────────────────────────────────────────────────

def do_verify():
    header("Verify Archive")

    if not core.is_mounted(MOUNT):
        error("No tape mounted.")
        pause()
        return

    choice = show_menu("Verify", [
        ("1", "Verify a single archive by ID (background)"),
        ("2", "Verify all archives on current tape (background)"),
        ("b", "Back"),
    ])

    if choice == "1":
        archive_id = prompt("Archive ID").upper().strip()
        if archive_id:
            job = core.submit_verify_job(
                state_dir=STATE_DIR, db_path=DB,
                archive_id=archive_id,
                mount_point=MOUNT, checksum_algo=ALGO,
            )
            info("Verify job submitted: {} — check Jobs menu (option 6).".format(
                job["job_id"]))
    elif choice == "2":
        tape_label = prompt("Tape label")
        if tape_label:
            archives = core.list_archives(DB, tape_label=tape_label.upper())
            for a in archives:
                job = core.submit_verify_job(
