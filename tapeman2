    if not tape_label:
        error("Tape label required.")
        pause()
        return

    lab = prompt("Lab name (optional)", default="")
    pi  = prompt("PI name (optional)", default="")

    info("Scanning tape contents...")
    contents = core.scan_tape_contents(MOUNT)

    if not contents:
        warn("No entries found on tape.")
        pause()
        return

    print()
    if RICH:
        from rich.table import Table
        from rich import box as rbox
        t = Table(box=rbox.SIMPLE_HEAVY, title="Tape Contents")
