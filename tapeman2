def _job_status_color(status):
    return {"running":"cyan","complete":"green","failed":"red",
            "cancelled":"dim","queued":"yellow"}.get(status,"white")

def show_jobs_table(jobs, title="Jobs"):
    if not jobs:
        warn("No jobs found.")
        return
    if RICH:
        from rich.table import Table
        from rich import box as rbox
        t = Table(title=title, box=rbox.SIMPLE_HEAVY)
        t.add_column("Job ID",  style="cyan", no_wrap=True)
        t.add_column("Type",    style="dim",  no_wrap=True)
        t.add_column("Dataset/Archive", max_width=24)
        t.add_column("Status",  no_wrap=True)
        t.add_column("Progress", max_width=36)
        t.add_column("Started", style="dim", no_wrap=True)
        t.add_column("Finished",style="dim", no_wrap=True)
        for j in jobs:
            c = _job_status_color(j.get("status",""))
            dataset  = j.get("name") or j.get("archive_id") or "—"
            finished = (j.get("finished") or "")[:16] or "—"
            t.add_row(
                j.get("job_id",""), j.get("type",""), dataset,
                "[{}]{}[/{}]".format(c, j.get("status",""), c),
                j.get("progress",""),
                (j.get("started") or "")[:16], finished,
            )
        console.print(t)
    else:
        fmt = "{:<10} {:<10} {:<20} {:<12} {:<32} {:<17} {}"
        print(fmt.format("Job ID","Type","Dataset","Status","Progress","Started","Finished"))
        print("-"*110)
        for j in jobs:
            dataset  = (j.get("name") or j.get("archive_id") or "—")[:19]
            finished = (j.get("finished") or "")[:16] or "—"
            print(fmt.format(
                j.get("job_id",""), j.get("type",""), dataset,
                j.get("status",""), (j.get("progress","") or "")[:31],
                (j.get("started") or "")[:16], finished,
            ))

