    else:
        fmt = "{:<4} {:<40} {:<10} {:<8} {}"
        print(fmt.format("#", "Name", "Size", "Files", "Type"))
        print("-" * 70)
        for i, e in enumerate(contents):
            print(fmt.format(i+1, e["name"][:39],
                             core.human_size(e["size_bytes"]),
                             e["file_count"],
                             "dir" if e["is_dir"] else "file"))
    print()

    compute_cs = confirm(
        "Compute checksums? (reads full tape — slow but gives verified status)",
        default=True
    )

