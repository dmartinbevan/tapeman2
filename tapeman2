def _check_permissions():
    """
    Check that the tape device is accessible.
    With world-accessible devices (mode 0666) any user can run tapeman2.
    Falls back to checking tape group membership for stricter setups.
    """
    import grp
    if os.geteuid() == 0:
        return  # root always OK

    sg = cfg.get("device", "sg_device", fallback="/dev/sg0")

    # Check direct device access first (works if device is 0666)
    if os.access(sg, os.R_OK | os.W_OK):
        return

    # Fall back: check tape group membership
    try:
        tape_gid = grp.getgrnam("tape").gr_gid
        if tape_gid in os.getgroups():
            return
    except KeyError:
        pass

    # Permission denied — give helpful message
    if RICH:
        console.print(
            "\n  [red bold]Permission denied.[/red bold]\n\n"
            "  Cannot access tape device: [cyan]{}[/cyan]\n\n"
            "  Ask your administrator to run:\n"
            "    [dim]sudo chmod 666 {}[/dim]\n"
            "  or add you to the tape group:\n"
            "    [dim]sudo usermod -aG tape {}[/dim]\n"
            "  (then log out and back in)".format(
                sg, sg, os.environ.get("USER", "your-username"))
        )
    else:
        print("\n  Permission denied: cannot access {}".format(sg))
        print("  Ask your admin: sudo chmod 666 {}".format(sg))
    sys.exit(1)


