    if not confirm("Import {} entries from tape '{}'?".format(
            len(contents), tape_label), default=True):
        warn("Import cancelled.")
        pause()
        return

    print()
    try:
        records = core.import_full_tape(
            tape_label=tape_label,
            db_path=DB,
            mount_point=MOUNT,
            lab=lab,
            pi=pi,
            checksum_algo=ALGO,
            compute_checksum=compute_cs,
            progress_cb=progress_msg,
            entry_metadata=entry_metadata,
        )
        print()
        if RICH:
            from rich.panel import Panel
            console.print(Panel(
                "[green bold]Import complete![/green bold]\n\n"
                "  {} entries registered from tape '{}'.\n"
                "  Status: {}\n\n"
                "[dim]View in Inventory → List all archives.[/dim]".format(
                    len(records), tape_label,
                    "verified" if compute_cs else "archived"),
                title="Import Complete", border_style="green"
            ))
        else:
            print("  Import complete — {} entries registered.".format(len(records)))
            for r in records:
                print("  {} — {}  ({})".format(
                    r.archive_id, r.name, core.human_size(r.size_bytes)))
