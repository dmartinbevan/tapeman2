# ── Console setup ─────────────────────────────────────────────────────────────
if RICH:
    console = Console()
else:
    class _Console:
        def print(self, *args, **kwargs):
            # Strip rich markup
            import re
            text = " ".join(str(a) for a in args)
            text = re.sub(r"\[.*?\]", "", text)
            print(text)
        def clear(self):
            os.system("clear")
        def rule(self, title=""):
            print(f"\n{'─'*60}  {title}  {'─'*60}\n" if title else "─"*80)
    console = _Console()

# ── Config ────────────────────────────────────────────────────────────────────
cfg       = core.initialize()
