# ── Helpers ───────────────────────────────────────────────────────────────────

def clear():
    console.clear()

def pause():
    input("\nPress Enter to continue...")

def header(subtitle=""):
    clear()
    if RICH:
        from rich.panel import Panel
        content = "[bold cyan]TapeMan 2[/bold cyan]  [dim]Quantum LTO-9 Archive Manager[/dim]"
        if subtitle:
            content += "\n[dim]{}[/dim]".format(subtitle)
        console.print(Panel.fit(content, border_style="cyan"))
    else:
        print("=" * 60)
        print("  TapeMan 2 — Quantum LTO-9 Archive Manager")
        if subtitle:
            print("  {}".format(subtitle))
        print("=" * 60)
    print()

def status_line():
    mounted = core.is_mounted(MOUNT)
    plat    = core._get_platform()

    if RICH:
        if mounted:
            free_str = _tape_free_nonblocking()
            console.print("  [green]●[/green]  [bold]Tape:[/bold]  "
                          "[green]Mounted at {}[/green]  [dim]({})[/dim]".format(
                              MOUNT, free_str))
        else:
            state, msg = core.tape_drive_state(ST, SG)
            if state == plat.TAPE_STATE_INITIALIZING:
                console.print("  [yellow]⏳[/yellow]  [bold]Tape:[/bold]  "
                              "[yellow]Initializing[/yellow]  [dim]— {}[/dim]".format(msg))
            elif state == plat.TAPE_STATE_NO_TAPE:
                console.print("  [dim]○[/dim]  [bold]Tape:[/bold]  [dim]No tape loaded[/dim]")
            elif state == plat.TAPE_STATE_NOT_READY:
                console.print("  [yellow]○[/yellow]  [bold]Tape:[/bold]  "
                              "[yellow]Not ready — loading...[/yellow]")
            else:
                console.print("  [yellow]○[/yellow]  [bold]Tape:[/bold]  [dim]Not mounted[/dim]")

        active = core.active_job_count(STATE_DIR)
        if active:
            console.print("  [cyan]⚙[/cyan]  [bold]Jobs:[/bold]  "
                          "[cyan]{} job{} running[/cyan]".format(
                              active, "s" if active != 1 else ""))

        needs_clean, clean_msg = _cleaning_status_nonblocking()
        if needs_clean:
            console.print("  [bold red]⚠[/bold red]  [bold red]DRIVE CLEANING "
                          "REQUIRED[/bold red]  [dim]— {}[/dim]".format(clean_msg))

    else:
        if mounted:
            free_str = _tape_free_nonblocking()
            print("  Tape: MOUNTED at {} ({})".format(MOUNT, free_str))
        else:
            state, msg = core.tape_drive_state(ST, SG)
            if state == plat.TAPE_STATE_INITIALIZING:
                print("  Tape: INITIALIZING — {}".format(msg))
            elif state == plat.TAPE_STATE_NO_TAPE:
                print("  Tape: no tape loaded")
            elif state == plat.TAPE_STATE_NOT_READY:
                print("  Tape: not ready — loading...")
            else:
                print("  Tape: not mounted")
        active = core.active_job_count(STATE_DIR)
        if active:
            print("  Jobs: {} job{} running".format(
                active, "s" if active != 1 else ""))
        needs_clean, clean_msg = _cleaning_status_nonblocking()
        if needs_clean:
            print("  *** DRIVE CLEANING REQUIRED — {} ***".format(clean_msg))

    print()

def _cleaning_status_nonblocking():
    """Get cleaning status with timeout — returns (bool, str)."""
    import threading
    result = [False, ""]
    def _check():
        try:
            result[0], result[1] = core.cleaning_status_str(SG, ST)
        except Exception:
            pass
    t = threading.Thread(target=_check, daemon=True)
    t.start()
    t.join(timeout=3)
    return result[0], result[1]

def _tape_free_nonblocking():
    """Get tape free space with a 2s timeout — returns string."""
    import threading
    result = [None]
    def _get():
        try:
            result[0] = core.human_size(core.tape_free_bytes(MOUNT))
        except Exception:
            result[0] = "unknown"
    t = threading.Thread(target=_get, daemon=True)
    t.start()
    t.join(timeout=2)
    return result[0] if result[0] else "calculating..."

def prompt(msg, default=""):
    if RICH:
        return Prompt.ask(f"  [cyan]{msg}[/cyan]", default=default)
    else:
        d = f" [{default}]" if default else ""
        return input(f"  {msg}{d}: ").strip() or default

def confirm(msg, default=True):
    if RICH:
        return Confirm.ask(f"  [cyan]{msg}[/cyan]", default=default)
    else:
        d = "Y/n" if default else "y/N"
        r = input(f"  {msg} [{d}]: ").strip().lower()
        if not r:
            return default
        return r.startswith("y")

def info(msg):
    if RICH:
        console.print(f"  [green]✔[/green] {msg}")
    else:
        print(f"  ✔ {msg}")

def warn(msg):
    if RICH:
        console.print(f"  [yellow]⚠[/yellow]  {msg}")
    else:
        print(f"  ⚠  {msg}")

def error(msg):
    if RICH:
        console.print(f"  [red]✘[/red]  {msg}")
    else:
        print(f"  ✘  {msg}")

def progress_msg(msg):
    if RICH:
        console.print(f"  [dim]→[/dim] {msg}")
    else:
        print(f"  → {msg}")

def show_menu(title, options):
    """Show a numbered menu, return chosen key."""
    if RICH:
        console.print(f"  [bold]{title}[/bold]\n")
        for key, label in options:
            console.print(f"  [cyan]{key}[/cyan])  {label}")
    else:
        print(f"  {title}\n")
        for key, label in options:
            print(f"  {key})  {label}")
    print()
    choice = input("  Enter choice: ").strip().lower()
    return choice

# ── Archive table display ─────────────────────────────────────────────────────

def show_archives_table(archives, title="Archives"):
    if not archives:
        warn("No archives found.")
        return

    if RICH:
        t = Table(title=title, box=box.SIMPLE_HEAVY, show_lines=False)
        t.add_column("ID",       style="cyan",  no_wrap=True)
        t.add_column("Name",     style="white", max_width=28)
        t.add_column("Lab/PI",   style="dim",   max_width=20)
        t.add_column("Tape",     style="yellow",no_wrap=True)
        t.add_column("Size",     style="green", justify="right")
        t.add_column("Date",     style="dim",   no_wrap=True)
        t.add_column("Status",   no_wrap=True)

        status_colors = {
            "archived": "white",
            "verified": "green",
            "restored": "blue",
            "corrupt":  "red",
            "dry_run":  "dim",
        }

        for a in archives:
            lab_pi = "/".join(filter(None, [a.lab, a.pi])) or "—"
            date = a.date_archived[:10] if a.date_archived else "—"
            color = status_colors.get(a.status, "white")
            t.add_row(
                a.archive_id, a.name, lab_pi, a.tape_label,
                core.human_size(a.size_bytes),
                date,
                f"[{color}]{a.status}[/{color}]"
            )
        console.print(t)
    else:
        fmt = "{:<12} {:<28} {:<18} {:<14} {:<10} {:<12} {:<10}"
        print(fmt.format("ID","Name","Lab/PI","Tape","Size","Date","Status"))
        print("-" * 108)
        for a in archives:
            lab_pi = "/".join(filter(None, [a.lab, a.pi])) or "—"
            date = a.date_archived[:10] if a.date_archived else "—"
            print(fmt.format(
                a.archive_id, a.name[:27], lab_pi[:17], a.tape_label,
                core.human_size(a.size_bytes), date, a.status
            ))

