            "Name for '{}' ({})".format(
                e["name"], core.human_size(e["size_bytes"])),
            default=e["name"]
        )
        entry_metadata[e["name"]] = {
            "name":  custom_name,
            "lab":   lab,
            "pi":    pi,
            "notes": "Imported from existing tape {}".format(tape_label),
        }

