class LogTab(ttk.Frame):
    def __init__(self, parent, app):
        super().__init__(parent)
        self.app = app
        self._build()

    def _build(self):
        top = ttk.Frame(self, padding=(16, 8))
        top.pack(fill="x")
        ttk.Label(top, text="Activity Log", font=FONT_H2,
                  foreground=CYAN, background=BG).pack(side="left")
        ttk.Button(top, text="Refresh", command=self._load).pack(side="right")

        self.text = scrolledtext.ScrolledText(
            self, bg=BG2, fg=FG, font=FONT_MONO,
            state="disabled", borderwidth=0, relief="flat"
        )
        self.text.pack(fill="both", expand=True, padx=16, pady=8)
        self._load()

    def _load(self):
        log_file = cfg.get("paths", "log_file",
                           fallback="/var/log/tapeman2/tapeman2.log")
        self.text.configure(state="normal")
        self.text.delete("1.0", "end")
        try:
            with open(log_file) as f:
                lines = f.readlines()
            self.text.insert("end", "".join(lines[-200:]))
        except FileNotFoundError:
            self.text.insert("end", "Log file not found. No operations logged yet.")
        except Exception as e:
            self.text.insert("end", f"Error reading log: {e}")
        self.text.see("end")
        self.text.configure(state="disabled")

