    def _verify_one(self):
        aid = self.var_id.get().strip().upper()
        if not aid:
            return
        self.log_clear()
        self.progress.start()
        try:
            job = core.submit_verify_job(
                state_dir=STATE_DIR, db_path=DB,
                archive_id=aid, mount_point=MOUNT, checksum_algo=ALGO,
            )
            self.log("✔ Verify job submitted: {}".format(job["job_id"]))
            self.log("  Check Jobs tab for result.")
            self.app.refresh_all()
        except Exception as e:
            self.log("\n✘ {}".format(e))
        finally:
            self.progress.stop()

    def _verify_tape(self):
        tape = self.var_tape.get().strip().upper()
        if not tape:
            return
        self.log_clear()
        self.progress.start()
        try:
            archives = core.list_archives(DB, tape_label=tape)
            for a in archives:
                job = core.submit_verify_job(
                    state_dir=STATE_DIR, db_path=DB,
                    archive_id=a.archive_id,
                    mount_point=MOUNT, checksum_algo=ALGO,
                )
                self.log("Submitted {} for {}".format(job["job_id"], a.archive_id))
            if archives:
                self.log("All verify jobs submitted — check Jobs tab.")
            else:
                self.log("No archives found for tape '{}'.".format(tape))
            self.app.refresh_all()
        except Exception as e:
            self.log("\n✘ {}".format(e))
        finally:
            self.progress.stop()

