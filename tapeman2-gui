                core.human_size(tp.total_bytes),
                tp.date_first_used[:10] if tp.date_first_used else "—",
                lv, tp.notes or "—"
            ))

    @run_in_thread
    def _mount(self):
        self.progress.start()
        self.log_clear()
        try:
            core.mount_tape(SG, MOUNT, progress_cb=self.log)
            self.log(f"✔ Mounted at {MOUNT}")
            self.app._refresh_status()
        except core.TapeError as e:
            self.log(f"✘ {e}")
        finally:
            self.progress.stop()

    @run_in_thread
    @run_in_thread
    def _unmount(self):
        self.progress.start()
        self.log_clear()
        # Check cleaning before unmount while drive is accessible
        self.log("Checking drive cleaning status...")
        needs_clean, clean_msg = core.cleaning_status_str(SG, ST)
        try:
            core.unmount_tape(MOUNT, progress_cb=self.log)
            self.log("✔ Unmounted.")
            core.eject_tape(ST)
            self.log("✔ Tape ejected.")
            self.app._refresh_status()
            # Show cleaning warning after successful eject
            if needs_clean:
                self.log("\n⚠  DRIVE NEEDS CLEANING")
                self.log("   Reason: {}".format(clean_msg))
                self.log("   Load a cleaning cartridge before the next archive job.")
                core.log_cleaning_event(DB, SG, action="cleaning_needed",
                                        notes=clean_msg)
                self.log("   (Logged to maintenance log.)")
                # Show popup on main thread
                self.after(0, lambda: messagebox.showwarning(
                    "Drive Cleaning Required",
                    "The tape drive needs cleaning.\n\n"
                    "Reason: {}\n\n"
                    "Please load a cleaning cartridge before\n"
                    "your next archive job.".format(clean_msg)
                ))
        except core.TapeError as e:
            self.log("✘ {}".format(e))
        finally:
            self.progress.stop()

    @run_in_thread
    def _format(self):
        label = self.var_fmt_label.get().strip().upper()
        if not label:
            messagebox.showerror("Error", "Tape label required.")
            return
        if not messagebox.askyesno("Confirm Format",
                                    f"ERASE ALL DATA on tape and format as '{label}'?\n\n"
                                    "This cannot be undone."):
            return
        self.progress.start()
        self.log_clear()
        try:
            core.format_tape(SG, label, progress_cb=self.log)
            core.add_tape(DB, label)
            self.log(f"✔ Tape '{label}' formatted and registered.")
            self.refresh()
            self.app._refresh_status()
        except core.TapeError as e:
            self.log(f"✘ {e}")
        finally:
            self.progress.stop()

    def _register(self):
        label = self.var_reg_label.get().strip().upper()
        notes = self.var_reg_notes.get().strip()
        if not label:
            messagebox.showerror("Error", "Label required.")
            return
        core.add_tape(DB, label, notes)
        self.log(f"Registered tape: {label}")
        self.refresh()

