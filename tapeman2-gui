        self.tab_restore  = RestoreTab(self.nb, self)
        self.tab_verify   = VerifyTab(self.nb, self)
        self.tab_jobs     = JobsTab(self.nb, self)
        self.tab_inventory= InventoryTab(self.nb, self)
        self.tab_tapes    = TapeTab(self.nb, self)
        self.tab_library  = LibraryTab(self.nb, self)
        self.tab_import   = ImportTab(self.nb, self)
        self.tab_log      = LogTab(self.nb, self)

