        self.nb.add(self.tab_restore,   text="  Restore  ")
        self.nb.add(self.tab_verify,    text="  Verify   ")
        self.nb.add(self.tab_jobs,      text="  Jobs     ")
        self.nb.add(self.tab_inventory, text="  Inventory")
        self.nb.add(self.tab_tapes,     text="  Tapes    ")
        self.nb.add(self.tab_library,   text="  Library  ")
        self.nb.add(self.tab_import,    text="  Import   ")
        self.nb.add(self.tab_log,       text="  Log      ")

        # ── Bottom log strip ──────────────────────────────────────────────────
        log_frame = ttk.Frame(self)
        log_frame.pack(fill="x", padx=16, pady=(0, 8))
        self.lbl_lastop = ttk.Label(log_frame, text="Ready.", style="Dim.TLabel")
        self.lbl_lastop.pack(side="left")

    def _refresh_status(self):
        mounted = core.is_mounted(MOUNT)
        if mounted:
            free = core.human_size(core.tape_free_bytes(MOUNT))
            total = core.human_size(core.tape_total_bytes(MOUNT))
            self.lbl_tape_status.config(
                text="● Tape: mounted at {}  ({} free / {})".format(MOUNT, free, total),
                foreground=GREEN
            )
        else:
            self.lbl_tape_status.config(
                text="○ Tape: not mounted",
                foreground=YELLOW
            )

        try:
            stg_free = core.human_size(core.free_bytes(STAGING))
            self.lbl_staging_status.config(
                text="Staging ({}): {} free".format(STAGING, stg_free)
            )
        except Exception:
            self.lbl_staging_status.config(text="Staging: unknown")

        # Cleaning check in background thread
        def _check_cleaning():
            needs_clean, msg = core.cleaning_status_str(SG, ST)
            self.after(0, lambda: self._update_cleaning_status(needs_clean, msg))
        import threading
        threading.Thread(target=_check_cleaning, daemon=True).start()

        self.after(30000, self._auto_refresh)

    def _update_cleaning_status(self, needs_clean, msg):
        if needs_clean:
            self.lbl_cleaning.config(
                text="⚠  DRIVE NEEDS CLEANING — {}".format(msg),
                foreground=RED
            )
            self.lbl_cleaning.pack(side="left", padx=(8, 0))
        else:
            self.lbl_cleaning.config(text="")
            self.lbl_cleaning.pack_forget()

    def _auto_refresh(self):
        self._refresh_status()

    def set_status(self, msg):
        self.lbl_lastop.config(text=msg)
        self.update_idletasks()

    def refresh_all(self):
        self._refresh_status()
        self.tab_inventory.refresh()
        self.tab_tapes.refresh()

# ── Shared log widget mixin ───────────────────────────────────────────────────

class LogMixin:
    def _make_log(self, parent, height=8):
        f = ttk.Frame(parent)
        ttk.Label(f, text="Output:", style="Dim.TLabel").pack(anchor="w")
        self.log_text = scrolledtext.ScrolledText(
            f, height=height, bg=BG2, fg=FG, font=FONT_MONO,
            insertbackground=FG, borderwidth=0, relief="flat",
            state="disabled"
        )
        self.log_text.pack(fill="both", expand=True)
        return f

    def log(self, msg):
        self.log_text.configure(state="normal")
        self.log_text.insert("end", msg + "\n")
        self.log_text.see("end")
        self.log_text.configure(state="disabled")
        if hasattr(self, "app"):
            self.app.set_status(msg)

    def log_clear(self):
        self.log_text.configure(state="normal")
        self.log_text.delete("1.0", "end")
        self.log_text.configure(state="disabled")

# ── Archive Tab ───────────────────────────────────────────────────────────────

class ArchiveTab(ttk.Frame, LogMixin):
    def __init__(self, parent, app):
        super().__init__(parent)
        self.app = app
        self.configure(style="TFrame")
        self._build()

    def _build(self):
        # Left: form
        left = ttk.Frame(self, padding=16)
        left.pack(side="left", fill="y")

        ttk.Label(left, text="Archive Dataset", font=FONT_H2,
                  foreground=CYAN, background=BG).grid(row=0, column=0, columnspan=3,
                                                        sticky="w", pady=(0,12))

        fields = [
            ("Source Path:",    "source_path",  ""),
            ("Dataset Name:",   "name",         ""),
            ("Tape Label:",     "tape_label",   ""),
            ("Lab:",            "lab",          ""),
            ("PI:",             "pi",           ""),
            ("Notes:",          "notes",        ""),
        ]
        self.vars = {}
        for i, (lbl, key, default) in enumerate(fields, start=1):
            ttk.Label(left, text=lbl).grid(row=i, column=0, sticky="e", padx=(0,8), pady=4)
            var = tk.StringVar(value=default)
            self.vars[key] = var
            if key == "source_path":
                f = ttk.Frame(left)
                f.grid(row=i, column=1, columnspan=2, sticky="ew", pady=4)
                ttk.Entry(f, textvariable=var, width=38, font=FONT_SM).pack(side="left")
                ttk.Button(f, text="Browse",
                           command=self._browse_source).pack(side="left", padx=(4,0))
            else:
                ttk.Entry(left, textvariable=var, width=42,
                          font=FONT_SM).grid(row=i, column=1, columnspan=2,
                                             sticky="ew", pady=4)

        # Tar bundle checkbox
        row = len(fields) + 1
        self.var_tar = tk.BooleanVar(value=TAR_DEF)
        ttk.Checkbutton(left, text="Bundle as tar (recommended for many small files)",
                        variable=self.var_tar).grid(row=row, column=0, columnspan=3,
                                                     sticky="w", pady=4)

        # Direct write checkbox
        row += 1
        self.var_direct = tk.BooleanVar(value=False)
        ttk.Checkbutton(left,
                        text="Direct write to tape (skip staging — use if source is on fast local disk)",
                        variable=self.var_direct).grid(row=row, column=0, columnspan=3,
                                                        sticky="w", pady=4)

        # Dry run checkbox
        row += 1
        self.var_dry = tk.BooleanVar(value=False)
        ttk.Checkbutton(left, text="Dry run (no data written)",
                        variable=self.var_dry).grid(row=row, column=0, columnspan=3,
                                                     sticky="w", pady=4)

        row += 1
        self.progress = ttk.Progressbar(left, mode="indeterminate",
                                         style="Horizontal.TProgressbar", length=300)
        self.progress.grid(row=row, column=0, columnspan=3, sticky="ew", pady=8)

        row += 1
        btn_frame = ttk.Frame(left)
        btn_frame.grid(row=row, column=0, columnspan=3, sticky="w")
        ttk.Button(btn_frame, text="Start Archive", style="Accent.TButton",
                   command=self._start_archive).pack(side="left", padx=(0,8))
        ttk.Button(btn_frame, text="Preflight Check",
                   command=self._preflight).pack(side="left")

        # Right: log
        right = ttk.Frame(self, padding=16)
        right.pack(side="right", fill="both", expand=True)
        self._make_log(right, height=20).pack(fill="both", expand=True)

    def _browse_source(self):
        path = filedialog.askdirectory(title="Select source directory")
        if path:
            self.vars["source_path"].set(path)

    def _preflight(self):
        src = self.vars["source_path"].get().strip()
        errors = core.preflight_check(src, STAGING, MOUNT, MIN_STG)
        if errors:
            messagebox.showwarning("Preflight Failed", "\n".join(errors))
        else:
            messagebox.showinfo("Preflight OK", "All preflight checks passed.")

    @run_in_thread
    def _start_archive(self):
        self.log_clear()
        self.progress.start()

        try:
            src    = self.vars["source_path"].get().strip()
            name   = self.vars["name"].get().strip()
            tape   = self.vars["tape_label"].get().strip().upper()
            lab    = self.vars["lab"].get().strip()
            pi     = self.vars["pi"].get().strip()
            notes  = self.vars["notes"].get().strip()
            use_tar= self.var_tar.get()
            direct = self.var_direct.get()
            dry    = self.var_dry.get()

            if not src or not name or not tape:
                messagebox.showerror("Error",
                    "Source path, name, and tape label are required.")
                return

            if dry:
                # Dry run stays synchronous for immediate feedback
                rec = core.archive_dataset(
                    source_path=src, name=name, tape_label=tape,
                    db_path=DB, staging_dir=STAGING, mount_point=MOUNT,
                    checksum_algo=ALGO, use_tar=use_tar,
                    lab=lab, pi=pi, notes=notes,
                    progress_cb=self.log, dry_run=True
                )
                self.log("\n✔ Dry run complete — would create {}".format(rec.archive_id))
                self.log("  Size: {}  Files: {}".format(
                    core.human_size(rec.size_bytes), rec.file_count))
                return

            # Submit background job
            job = core.submit_archive_job(
                state_dir=STATE_DIR, db_path=DB,
                source_path=src, name=name, tape_label=tape,
                staging_dir=STAGING, mount_point=MOUNT,
                checksum_algo=ALGO, use_tar=use_tar,
                lab=lab, pi=pi, notes=notes,
                cfg=cfg, sg_device=SG, st_device=ST,
                direct_write=direct,
            )
            self.log("✔ Archive job submitted: {}".format(job["job_id"]))
            self.log("  Running in background — check the Jobs tab for progress.")
            self.app.set_status("Archive job submitted: {}".format(job["job_id"]))
            self.app.refresh_all()
            messagebox.showinfo("Job Submitted",
                "Archive job submitted!\n\n"
                "Job ID: {}\n"
                "Dataset: {}\n"
                "Tape: {}\n\n"
                "Running in background.\n"
                "Check the Jobs tab for progress.".format(
                    job["job_id"], name, tape))
        except Exception as e:
            self.log("\n✘ Error: {}".format(e))
            self.app.set_status("Archive failed: {}".format(e))
            messagebox.showerror("Archive Failed", str(e))
        finally:
            self.progress.stop()

# ── Restore Tab ───────────────────────────────────────────────────────────────

class RestoreTab(ttk.Frame, LogMixin):
    def __init__(self, parent, app):
        super().__init__(parent)
        self.app = app
        self._build()

    def _build(self):
        left = ttk.Frame(self, padding=16)
        left.pack(side="left", fill="y")

        ttk.Label(left, text="Restore Dataset", font=FONT_H2,
                  foreground=CYAN, background=BG).pack(anchor="w", pady=(0,12))

        # Archive selector
        f1 = ttk.Frame(left)
        f1.pack(fill="x", pady=4)
        ttk.Label(f1, text="Archive ID:").pack(side="left", padx=(0,8))
        self.var_id = tk.StringVar()
        ttk.Entry(f1, textvariable=self.var_id, width=16,
                  font=FONT_SM).pack(side="left")
        ttk.Button(f1, text="Lookup",
                   command=self._lookup).pack(side="left", padx=(8,0))

        # Info display
        self.info_text = tk.Text(left, height=7, width=50, bg=BG2, fg=FG,
                                  font=FONT_MONO, state="disabled",
                                  relief="flat", borderwidth=0)
        self.info_text.pack(fill="x", pady=8)

        # Destination
        f2 = ttk.Frame(left)
        f2.pack(fill="x", pady=4)
        ttk.Label(f2, text="Destination:").pack(side="left", padx=(0,8))
        self.var_dest = tk.StringVar(value=RESTORE)
        ttk.Entry(f2, textvariable=self.var_dest, width=34,
                  font=FONT_SM).pack(side="left")
        ttk.Button(f2, text="Browse",
                   command=self._browse_dest).pack(side="left", padx=(4,0))

        self.progress = ttk.Progressbar(left, mode="indeterminate", length=300,
                                         style="Horizontal.TProgressbar")
        self.progress.pack(fill="x", pady=8)

        ttk.Button(left, text="Start Restore", style="Accent.TButton",
                   command=self._start_restore).pack(anchor="w")

        # Right: archive list + log
        right = ttk.Frame(self, padding=16)
        right.pack(side="right", fill="both", expand=True)

        ttk.Label(right, text="All Archives:", style="Dim.TLabel").pack(anchor="w")
        self.tree = self._make_tree(right)
        self.tree.pack(fill="both", expand=True, pady=(4, 8))
        self.tree.bind("<<TreeviewSelect>>", self._on_select)
        self.refresh()

        self._make_log(right, height=6).pack(fill="both")

    def _make_tree(self, parent):
        cols = ("id", "name", "tape", "size", "date", "status")
        t = ttk.Treeview(parent, columns=cols, show="headings", height=10)
        for col, w, heading in [
            ("id",   90,  "ID"),
            ("name", 180, "Name"),
            ("tape", 110, "Tape"),
            ("size",  80, "Size"),
            ("date",  95, "Date"),
            ("status",80, "Status"),
        ]:
            t.heading(col, text=heading)
            t.column(col, width=w, anchor="w")
        sb = ttk.Scrollbar(parent, orient="vertical", command=t.yview)
        t.configure(yscrollcommand=sb.set)
        sb.pack(side="right", fill="y")
        return t

    def refresh(self):
        for row in self.tree.get_children():
            self.tree.delete(row)
        for a in core.list_archives(DB):
            self.tree.insert("", "end", values=(
                a.archive_id, a.name, a.tape_label,
                core.human_size(a.size_bytes),
                a.date_archived[:10] if a.date_archived else "",
                a.status
            ))

    def _on_select(self, _):
        sel = self.tree.selection()
        if sel:
            vals = self.tree.item(sel[0])["values"]
            self.var_id.set(vals[0])
            self._lookup()

    def _lookup(self):
        aid = self.var_id.get().strip().upper()
        rec = core.get_archive(DB, aid)
        self.info_text.configure(state="normal")
        self.info_text.delete("1.0", "end")
        if rec:
            self.info_text.insert("end",
                f"Archive ID:  {rec.archive_id}\n"
                f"Name:        {rec.name}\n"
                f"Tape:        {rec.tape_label}  ← load this tape\n"
                f"Size:        {core.human_size(rec.size_bytes)}\n"
                f"Files:       {rec.file_count}\n"
                f"Date:        {rec.date_archived}\n"
                f"Source was:  {rec.source_path}"
            )
        else:
            self.info_text.insert("end", f"Archive ID '{aid}' not found.")
        self.info_text.configure(state="disabled")

    def _browse_dest(self):
        path = filedialog.askdirectory(title="Select restore destination")
        if path:
            self.var_dest.set(path)

    def _start_restore(self):
        aid  = self.var_id.get().strip().upper()
        dest = self.var_dest.get().strip()
        if not aid or not dest:
            messagebox.showerror("Error", "Archive ID and destination are required.")
            return

        self.log_clear()
        self.progress.start()

        try:
            job = core.submit_restore_job(
                state_dir=STATE_DIR, db_path=DB,
                archive_id=aid, dest_path=dest,
                mount_point=MOUNT, checksum_algo=ALGO,
                cfg=cfg, sg_device=SG, st_device=ST,
            )
            self.log("✔ Restore job submitted: {}".format(job["job_id"]))
            self.log("  Running in background — check the Jobs tab for progress.")
            self.app.set_status("Restore job submitted: {}".format(job["job_id"]))
            messagebox.showinfo("Job Submitted",
                "Restore job submitted!\n\n"
                "Job ID: {}\n"
                "Archive: {}\n"
                "Destination: {}\n\n"
                "Running in background.\n"
                "Check the Jobs tab for progress.".format(
                    job["job_id"], aid, dest))
            self.refresh()
        except Exception as e:
            self.log("\n✘ {}".format(e))
            self.app.set_status("Restore failed: {}".format(e))
            messagebox.showerror("Restore Failed", str(e))
        finally:
            self.progress.stop()

