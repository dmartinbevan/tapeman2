class JobsTab(ttk.Frame):
    def __init__(self, parent, app):
        super().__init__(parent)
        self.app = app
        self._build()
        self.after(5000, self._auto_refresh)

    def _build(self):
        top = ttk.Frame(self, padding=(16, 8))
        top.pack(fill="x")
        ttk.Label(top, text="Background Jobs", font=FONT_H2,
                  foreground=CYAN, background=BG).pack(side="left")
        ttk.Button(top, text="⟳ Refresh", command=self.refresh).pack(side="right")
        ttk.Button(top, text="Cancel Job",
                   command=self._cancel_job).pack(side="right", padx=(0,8))
        ttk.Button(top, text="Clean Up Old Jobs",
                   command=self._cleanup).pack(side="right", padx=(0,8))

        # Treeview
        frame = ttk.Frame(self, padding=(16,4))
        frame.pack(fill="both", expand=True)

        cols = ("job_id","type","dataset","status","progress","started","finished")
        self.tree = ttk.Treeview(frame, columns=cols, show="headings")
        for col, w, heading in [
            ("job_id",   90,  "Job ID"),
            ("type",     70,  "Type"),
            ("dataset", 180,  "Dataset / Archive"),
            ("status",   90,  "Status"),
            ("progress",280,  "Progress"),
            ("started",  130, "Started"),
            ("finished", 130, "Finished"),
        ]:
            self.tree.heading(col, text=heading)
            self.tree.column(col, width=w, anchor="w")

        vsb = ttk.Scrollbar(frame, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=vsb.set)
        self.tree.grid(row=0, column=0, sticky="nsew")
        vsb.grid(row=0, column=1, sticky="ns")
        frame.rowconfigure(0, weight=1)
        frame.columnconfigure(0, weight=1)

        self.tree.tag_configure("running",   foreground=CYAN)
        self.tree.tag_configure("complete",  foreground=GREEN)
        self.tree.tag_configure("failed",    foreground=RED)
        self.tree.tag_configure("cancelled", foreground=FG_DIM)
        self.tree.tag_configure("queued",    foreground=YELLOW)

        # Detail strip
        det = ttk.Frame(self, padding=(16,4))
        det.pack(fill="x")
        self.lbl_detail = ttk.Label(det, text="", style="Dim.TLabel")
        self.lbl_detail.pack(side="left")
        self.tree.bind("<<TreeviewSelect>>", self._on_select)

        self.refresh()

    def refresh(self):
        sel = self.tree.selection()
        sel_id = self.tree.item(sel[0])["values"][0] if sel else None

        for row in self.tree.get_children():
            self.tree.delete(row)

        jobs = core.list_jobs(STATE_DIR)
        for j in jobs:
            status   = j.get("status","")
            dataset  = j.get("name") or j.get("archive_id") or "—"
            finished = (j.get("finished") or "")[:16] or "—"
            iid = self.tree.insert("", "end", iid=j.get("job_id",""),
                values=(
                    j.get("job_id",""),
                    j.get("type",""),
                    dataset,
                    status,
                    j.get("progress",""),
                    (j.get("started") or "")[:16],
                    finished,
                ), tags=(status,))

        # Update status bar active job count
        active = sum(1 for j in jobs if j.get("status") == core.JOB_STATUS_RUNNING)
        if active:
            self.app.set_status("{} job{} running".format(
                active, "s" if active != 1 else ""))

        # Restore selection
        if sel_id:
            try:
                self.tree.selection_set(sel_id)
            except Exception:
                pass

    def _on_select(self, _):
        sel = self.tree.selection()
        if not sel:
            return
        job_id = sel[0]
        j = core.get_job(STATE_DIR, job_id)
        if j:
            err = "  Error: {}".format(j["error"]) if j.get("error") else ""
            self.lbl_detail.config(
                text="{}  {}  {}{}".format(
                    j.get("job_id",""), j.get("type",""),
                    j.get("progress",""), err)
            )

    def _cancel_job(self):
        sel = self.tree.selection()
        if not sel:
            messagebox.showinfo("Cancel Job", "Select a job to cancel.")
            return
        job_id = sel[0]
        if messagebox.askyesno("Cancel Job",
                               "Cancel job {}?".format(job_id)):
            if core.cancel_job(STATE_DIR, job_id):
                self.refresh()
            else:
                messagebox.showerror("Error",
                    "Could not cancel {} — not running or not found.".format(job_id))

    def _cleanup(self):
        removed = core.cleanup_jobs(STATE_DIR, keep_days=7)
        self.refresh()
        messagebox.showinfo("Cleanup",
            "Removed {} completed job file{}.".format(
                removed, "s" if removed != 1 else ""))

    def _auto_refresh(self):
        self.refresh()
        self.after(5000, self._auto_refresh)

