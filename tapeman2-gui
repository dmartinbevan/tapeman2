# ── Utilities ─────────────────────────────────────────────────────────────────

def run_in_thread(fn):
    """Decorator to run a function in a background thread."""
    def wrapper(*args, **kwargs):
        t = threading.Thread(target=fn, args=args, kwargs=kwargs, daemon=True)
        t.start()
    return wrapper

# ── Base Window ───────────────────────────────────────────────────────────────

class TapeMan2App(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("TapeMan 2 — Quantum LTO-9 Archive Manager")
        self.geometry("1100x720")
        self.minsize(900, 600)
        self.configure(bg=BG)
        self.resizable(True, True)
        self.update_idletasks()  # force geometry calculation before building UI

        self._apply_styles()
        self._build_ui()
        self.update()          # force full redraw
        self._refresh_status()
        self.after(10000, self._auto_refresh)  # refresh status every 10s

