    def _draw_map(self):
        self.canvas.delete("all")
        if not self._status:
            return

        x0, y0 = 10, 10
        slot_w, slot_h, pad = 90, 36, 6
        cols = 8

        def draw_slot(idx, slot, x, y):
            color = GREEN if slot.occupied else BG3
            fg = BG if slot.occupied else FG_DIM
            self.canvas.create_rectangle(x, y, x+slot_w, y+slot_h,
                                          fill=color, outline=BG, width=1)
            label = slot.barcode or slot.label or "(empty)"
            type_str = {"drive":"DRV","storage":"S","ie":"I/E"}.get(
                slot.slot_type, "?")
            self.canvas.create_text(x + slot_w//2, y + 10,
                                     text="{}{} {}".format(
                                         type_str, slot.slot_num,
                                         ("*LOADED*" if slot.slot_type=="drive"
                                          and slot.occupied else "")),
                                     fill=CYAN, font=("Courier", 7, "bold"),
                                     anchor="center")
            self.canvas.create_text(x + slot_w//2, y + 24,
                                     text=label[:12],
                                     fill=fg, font=("Courier", 7),
                                     anchor="center")

        all_slots = self._status.drives + self._status.ie_slots + self._status.slots
        for i, slot in enumerate(all_slots):
            col = i % cols
            row = i // cols
            x = x0 + col * (slot_w + pad)
            y = y0 + row * (slot_h + pad)
            draw_slot(i, slot, x, y)

        total_h = y0 + ((len(all_slots) // cols) + 1) * (slot_h + pad) + 20
        self.canvas.configure(scrollregion=(0, 0, x0 + cols*(slot_w+pad), total_h))

    @run_in_thread
    def _inventory(self):
        self.progress.start()
        self.log_clear()
        try:
            core.changer_inventory_scan(
                core.get_changer_device(cfg), DB, progress_cb=self.log)
            self._refresh()
            self.log("Inventory scan complete.")
        except Exception as e:
            self.log("Error: {}".format(e))
        finally:
            self.progress.stop()

    @run_in_thread
    def _manual_load(self):
        try:
            slot = int(self.var_slot.get())
            drive = int(self.var_drive.get())
        except ValueError:
            messagebox.showerror("Error", "Slot and drive must be integers.")
            return
        self.progress.start()
        self.log_clear()
        try:
            ch = core._get_changer()
            ch.load_tape(core.get_changer_device(cfg), slot, drive,
                         progress_cb=self.log)
            core._log_changer_op(DB, "load", slot, drive, "", "ok")
            self._refresh()
        except Exception as e:
            self.log("Error: {}".format(e))
        finally:
            self.progress.stop()

    @run_in_thread
    def _manual_unload(self):
        try:
            slot = int(self.var_slot.get())
            drive = int(self.var_drive.get())
        except ValueError:
            messagebox.showerror("Error", "Slot and drive must be integers.")
            return
        self.progress.start()
        self.log_clear()
        try:
            ch = core._get_changer()
            ch.unload_tape(core.get_changer_device(cfg), slot, drive,
                           progress_cb=self.log)
            core._log_changer_op(DB, "unload", slot, drive, "", "ok")
            self._refresh()
        except Exception as e:
            self.log("Error: {}".format(e))
        finally:
            self.progress.stop()

    @run_in_thread
    def _find_and_load(self):
        label = self.var_find_label.get().strip().upper()
        if not label:
            messagebox.showerror("Error", "Enter a tape label.")
            return
        drive = int(self.var_drive.get() or "0")
        self.progress.start()
        self.log_clear()
        try:
            slot = core.changer_load(
                core.get_changer_device(cfg), label, drive,
                db_path=DB, progress_cb=self.log)
            self.log("Tape '{}' loaded from slot {}.".format(label, slot))
            self._refresh()
            self.app._refresh_status()
        except Exception as e:
            self.log("Error: {}".format(e))
        finally:
            self.progress.stop()

