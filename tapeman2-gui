def _check_permissions():
    import grp
    if os.geteuid() == 0:
        return
    sg = cfg.get("device", "sg_device", fallback="/dev/sg0")
    if os.access(sg, os.R_OK | os.W_OK):
        return
    try:
        tape_gid = grp.getgrnam("tape").gr_gid
        if tape_gid in os.getgroups():
            return
    except KeyError:
        pass
    try:
        import tkinter.messagebox as mb
        mb.showerror(
            "Permission Denied",
            "Cannot access tape device: {}\n\n"
            "Ask your administrator to run:\n"
            "  sudo chmod 666 {}\n\n"
            "or add you to the tape group:\n"
            "  sudo usermod -aG tape {}\n"
            "(then log out and back in)".format(
                sg, sg, os.environ.get("USER", "your-username"))
        )
    except Exception:
        print("Permission denied: cannot access {}".format(sg))
    sys.exit(1)


def main():
    _check_permissions()

    app = TapeMan2App()
    app.mainloop()

if __name__ == "__main__":
    main()
