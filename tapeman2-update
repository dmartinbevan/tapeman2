#!/bin/bash
# tapeman2-update — Pull latest code from GitHub and reinstall
# Run as root: sudo tapeman2-update

set -e

REPO_DIR="/usr/local/src/tapeman2"
REPO_URL="https://github.com/dmartinbevan/tapeman2.git"
INSTALL_SCRIPT="install.sh"

# ── Colors ────────────────────────────────────────────────────────────────────
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

info()  { echo -e "  ${GREEN}✔${NC}  $1"; }
warn()  { echo -e "  ${YELLOW}⚠${NC}   $1"; }
error() { echo -e "  ${RED}✘${NC}  $1"; }
step()  { echo -e "\n  ${CYAN}▶${NC}  $1"; }

echo ""
echo -e "  ${CYAN}TapeMan 2 — Update${NC}"
echo    "  ==================="
echo ""

# ── Check root ────────────────────────────────────────────────────────────────
if [[ $EUID -ne 0 ]]; then
    error "Run as root: sudo tapeman2-update"
    exit 1
fi

# ── Check git ─────────────────────────────────────────────────────────────────
if ! command -v git &>/dev/null; then
    error "git not found. Install it: dnf install -y git"
    exit 1
fi

# ── Check for running jobs ────────────────────────────────────────────────────
JOBS_DIR="/var/lib/tapeman2/jobs"
if [ -d "$JOBS_DIR" ]; then
    RUNNING=$(grep -l '"status": "running"' "$JOBS_DIR"/*.json 2>/dev/null | wc -l)
    if [ "$RUNNING" -gt 0 ]; then
        warn "$RUNNING tapeman2 job(s) currently running."
        echo ""
        echo "  Updating while jobs are running is safe — jobs are independent"
        echo "  processes and will complete normally. The updated code will be"
        echo "  used by new jobs after this update."
        echo ""
        read -rp "  Continue with update? [Y/n]: " confirm
        if [[ "$confirm" =~ ^[Nn]$ ]]; then
            echo "  Update cancelled."
            exit 0
        fi
    fi
fi

# ── Clone or pull ─────────────────────────────────────────────────────────────
if [ -d "$REPO_DIR/.git" ]; then
    step "Pulling latest changes from GitHub..."
    cd "$REPO_DIR"

    # Show current version
    CURRENT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
    info "Current commit: $CURRENT"

    # Fetch and pull
    git fetch origin
    REMOTE=$(git rev-parse --short origin/main 2>/dev/null || \
             git rev-parse --short origin/master 2>/dev/null || echo "unknown")

    if [ "$CURRENT" = "$REMOTE" ]; then
        info "Already up to date ($CURRENT)."
        echo ""
        read -rp "  Reinstall anyway? [y/N]: " reinstall
        if [[ ! "$reinstall" =~ ^[Yy]$ ]]; then
            echo "  Nothing to do."
            exit 0
        fi
    else
        info "Updating: $CURRENT → $REMOTE"
        git pull origin main 2>/dev/null || git pull origin master 2>/dev/null
        # Show what changed
        echo ""
        echo "  Changes:"
        git log --oneline "${CURRENT}..HEAD" | head -10 | sed 's/^/    /'
        echo ""
    fi

else
    step "Cloning tapeman2 from GitHub..."
    mkdir -p "$(dirname "$REPO_DIR")"
    git clone "$REPO_URL" "$REPO_DIR"
    cd "$REPO_DIR"
    info "Cloned to $REPO_DIR"
fi

# ── Run installer ─────────────────────────────────────────────────────────────
step "Running installer..."
cd "$REPO_DIR"

if [ ! -f "$INSTALL_SCRIPT" ]; then
    error "install.sh not found in $REPO_DIR"
    exit 1
fi

bash "$INSTALL_SCRIPT"

# ── Show version ──────────────────────────────────────────────────────────────
echo ""
NEW=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
info "tapeman2 updated to commit $NEW"
echo ""
echo "  Run tapeman2 to start."
echo ""
